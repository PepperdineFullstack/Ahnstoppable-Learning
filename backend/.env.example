# ── Server ────────────────────────────────────────────────────────────────────
PORT=4000

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@localhost:5432/ahnstoppable

# ── Auth ──────────────────────────────────────────────────────────────────────
# Long random string, e.g. from: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# From Google Cloud Console → APIs & Services → Credentials.
# Add GOOGLE_CALLBACK_URL as an authorized redirect URI there.
# Leave blank to disable Google sign-in (email/password still works).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Frontend origin ───────────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
