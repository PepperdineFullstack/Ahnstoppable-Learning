# Copy to backend/.env and fill in. backend/.env is gitignored.
# Only these four are read by backend/src — the GOOGLE_* / CLIENT_URL vars
# some older .env files carry over are leftovers from the removed passport code.

PORT=4000

# Read at module scope in src/db/pool.js, so `import 'dotenv/config'` must stay
# the FIRST import in src/index.js. If this fails to load, pg silently falls back
# to libpq defaults and connects to the wrong database instead of erroring.
DATABASE_URL=postgresql://USER@localhost:5432/ahnstoppable

JWT_SECRET=change-me

# Comma-separated; split on ',' in src/index.js. Vite defaults to 5173 but walks
# forward to 5174/5175 when a port is taken, so all three are listed — otherwise
# the browser gets opaque CORS failures while curl keeps working.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175
