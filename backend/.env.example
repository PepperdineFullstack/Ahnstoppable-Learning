# Copy to backend/.env and fill in. backend/.env is gitignored.
# Only these five are read by backend/src — the GOOGLE_* / CLIENT_URL vars
# some older .env files carry over are leftovers from the removed passport code.

PORT=4000

# Read at module scope in src/db/pool.js, so `import 'dotenv/config'` must stay
# the FIRST import in src/index.js. The server refuses to boot if this is unset.
DATABASE_URL=postgresql://USER@localhost:5432/ahnstoppable

# Required; the server refuses to boot if unset.
JWT_SECRET=change-me

# Required; comma-separated, split on ',' in src/index.js. Vite defaults to 5173
# but walks forward to 5174/5175 when a port is taken, so all three are listed —
# otherwise the browser gets opaque CORS failures while curl keeps working.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:5175

# Invite code required to register a professor account (POST /api/auth/register
# with role=professor). Leave unset to disable professor signup entirely.
PROFESSOR_SIGNUP_CODE=
