# Copy to .env (gitignored) to point the frontend at a non-default backend.
# Optional: client/src/api/axios.js and api/socket.js both fall back to
# http://localhost:4000 when this is unset, which is correct for local dev.
#
# Note: frontend/.env also defines this, but frontend/ is dead build output and
# Vite never reads it. This root file is the one that applies.

VITE_API_URL=http://localhost:4000
